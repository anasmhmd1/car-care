DATABASE_URL="postgresql://bareeq:change-me@localhost:5432/bareeq_db?schema=public"
DIRECT_URL="postgresql://bareeq:change-me@localhost:5432/bareeq_db?schema=public"
SESSION_SECRET="replace-with-output-of-openssl-rand-base64-48"
SESSION_TTL_DAYS="7"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"

# For Vercel / Cloud deployments with Supabase Storage:
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
# SUPABASE_STORAGE_BUCKET="bareeq-uploads"

# `local` uses the replaceable StorageAdapter backed by UPLOAD_DIR (with auto-fallback on serverless).
# `supabase` uses Supabase Storage for persistent cloud uploads across Vercel serverless instances.
# Booking evidence, subscription payment proofs, and catalog media share this store.
# Subscription payments are reviewed manually; no gateway credentials are required.

# Booking workflow hold windows. Keep them positive integers in minutes.
BOOKING_HOLD_MINUTES="30"
PAYMENT_REVIEW_HOLD_MINUTES="1440"
OPERATIONS_REVIEW_HOLD_MINUTES="1440"
RESCHEDULE_HOLD_MINUTES="1440"

# One-time production System Admin bootstrap. Export/inject only for `npm run admin:bootstrap`,
# then remove these values from the runtime environment/secret injection. Email may be blank.
# Replace every placeholder. The command loads Next env files, but injected process values win.
BOOTSTRAP_ADMIN_NAME="replace-with-the-initial-system-admin-name"
BOOTSTRAP_ADMIN_PHONE="replace-with-the-initial-system-admin-phone"
BOOTSTRAP_ADMIN_EMAIL="replace-with-the-initial-system-admin-email"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-temporary-admin-password"

# Required only by the development/test seed. The seed refuses NODE_ENV=production.
SEED_PASSWORD="replace-with-a-long-temporary-demo-password"
SEED_ADMIN_PASSWORD="replace-with-a-separate-long-temporary-admin-password"

# Acceptance E2E: point only at a disposable database populated by `npm run db:seed`.
# Mutating acceptance scenarios intentionally do not fall back to DATABASE_URL.
E2E_DATABASE_URL=""
# Omit this to let Playwright start the local Next.js dev server itself.
E2E_BASE_URL=""
# Local port used only when Playwright manages the server (defaults to 3000 if omitted).
E2E_PORT="3417"

# Production accepts UUID identifiers for public availability requests. Leave
# this unset/false. Set true only during a short, controlled migration from a
# legacy demo catalog that still uses `seed-*` IDs.
ALLOW_LEGACY_SEED_IDS="false"

# Docker Compose database/runtime settings
POSTGRES_USER="bareeq"
POSTGRES_PASSWORD="replace-with-a-long-url-safe-password"
POSTGRES_DB="bareeq_db"
POSTGRES_PORT="5432"
APP_PORT="3000"
